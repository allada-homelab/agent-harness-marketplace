              }
            ]
          }
        ]
      },
      "native": {
        "pi": {
          "event": "tool_call",
          "toolName": "read",
          "input": {
            "path": "/tmp/x.txt"
          }
        },
        "dsh": {
          "event": "tools/pre-execute",
          "name": "read",
          "args": {
            "path": "/tmp/x.txt"
          }
        }
      },
      "outcome": "allow"
    },
    {
      "name": "pretooluse-empty-matcher-matches-everything",
