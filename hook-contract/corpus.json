    {
      "name": "posttooluse-receives-response",
      "harness": [
        "pi",
        "dsh"
      ],
      "hooks": {
        "PostToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/fixtures/echo.py\""
              }
            ]
          }
        ]
      },
      "native": {
        "pi": {
          "event": "tool_result",
          "toolName": "bash",
          "input": {
            "command": "echo hi"
          },
          "content": [
            {
              "type": "text",
              "text": "hi\n"
            }
          ]
        },
        "dsh": {
          "event": "tools/post-execute",
          "name": "bash",
          "args": {
            "command": "echo hi"
          },
          "result": "hi\n"
        }
      },
      "stdin": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "echo hi"
        },
        "tool_response": "hi\n"
      },
      "outcome": "allow"
    },
