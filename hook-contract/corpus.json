              }
            ]
          }
        ]
      },
      "native": {
        "pi": {
          "event": "tool_call",
          "toolName": "read",
          "input": {
            "path": "/tmp/x.txt"
          }
        },
        "dsh": {
          "event": "tools/pre-execute",
          "name": "read",
          "args": {
            "file_path": "/tmp/x.txt"
          }
        }
      },
      "stdin": {
        "tool_name": "Read",
        "tool_input": {
          "file_path": "/tmp/x.txt"
        }
      },
      "outcome": "allow"
    },
