{
  "$comment": "Conformance corpus for hook-runner-pi and hook-runner-dsh. See README.md. `native` is the event as the harness delivers it; `stdin` is what the fixture must have received.",
  "cases": [
    {
      "name": "pretooluse-bash-translated-and-allowed",
      "harness": [
        "pi",
        "dsh"
      ],
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/fixtures/echo.py\""
              }
            ]
          }
        ]
      },
      "native": {
        "pi": {
          "event": "tool_call",
          "toolName": "bash",
          "input": {
            "command": "ls -la"
          }
        },
        "dsh": {
          "event": "tools/pre-execute",
          "name": "bash",
          "args": {
            "command": "ls -la"
          }
        }
      },
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "ls -la"
        }
      },
      "outcome": "allow"
    },
    {
      "name": "pretooluse-read-translated",
      "harness": [
        "pi",
        "dsh"
      ],
      "hooks": {
        "PreToolUse": [
