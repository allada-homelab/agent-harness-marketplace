    {
      "name": "pretooluse-rewrite-command",
      "harness": [
        "pi",
        "dsh"
      ],
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/fixtures/rewrite.py\""
              }
            ]
          }
        ]
      },
      "native": {
        "pi": {
          "event": "tool_call",
          "toolName": "bash",
          "input": {
            "command": "ls"
          }
        },
        "dsh": {
          "event": "tools/pre-execute",
          "name": "bash",
          "args": {
            "command": "ls"
          }
        }
      },
      "updatedInput": {
        "command": "echo rewritten; ls"
      },
      "outcome_by_harness": {
        "pi": "rewrite",
        "dsh": "deny"
      },
      "reason": "echo rewritten; ls",
      "$comment": "dsh freezes tool arguments before pre-execute: a rewrite becomes a deny whose reason carries the intended input (see README)."
    },
