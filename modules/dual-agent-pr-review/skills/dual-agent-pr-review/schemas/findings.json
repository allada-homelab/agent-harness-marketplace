{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": {
      "type": "string",
      "description": "Two or three sentences: what the PR does and your overall verdict."
    },
    "findings": {
      "type": "array",
      "description": "One entry per distinct defect. Empty array if the PR is clean.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "severity",
          "category",
          "file",
          "line",
          "symbol",
          "claim",
          "failure_scenario",
          "evidence",
          "confidence",
          "suggested_fix"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Sequential id using the prefix you were given, e.g. CC-1, CC-2."
          },
          "title": {
            "type": "string",
            "description": "Under 80 characters. The claim alone, no rationale."
          },
          "severity": {
            "type": "string",
            "enum": ["blocking", "non-blocking"]
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "performance",
              "concurrency",
              "error-handling",
              "test-coverage",
              "maintainability",
              "convention",
              "documentation"
            ]
          },
          "file": {
            "type": "string",
            "description": "Repo-relative path."
          },
          "line": {
            "type": "integer",
            "description": "1-indexed line in the PR head revision. Use 0 only if genuinely file-wide."
          },
          "symbol": {
            "type": "string",
            "description": "Enclosing function/class/constant name, or \"\" if none."
          },
          "claim": {
            "type": "string",
            "description": "One sentence stating the defect."
          },
          "failure_scenario": {
            "type": "string",
            "description": "Concrete inputs or state, then the wrong output/crash/leak that results. Not a generalization."
          },
          "evidence": {
            "type": "string",
            "description": "file:line references plus quoted code that proves the claim. Cite every file you relied on, including ones outside the diff."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "suggested_fix": {
            "type": "string",
            "description": "The smallest change that resolves it."
          }
        }
      }
    }
  }
}
