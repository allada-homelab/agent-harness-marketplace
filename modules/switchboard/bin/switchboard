#!/usr/bin/env python3
# Imports the CLI rather than holding it: Python caches an imported module's bytecode but
# recompiles a script on every run, and the hooks run this on every tool call.
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "skills", "switchboard"))
from switchboard import main  # noqa: E402

main()
