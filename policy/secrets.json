{
  "$comment": [
    "Credential detection rules, shared by every harness. Data only \u2014 the",
    "matching ENGINE is implemented once per harness and all three are held to",
    "policy/testcases.json, which is the real guarantee that they agree.",
    "",
    "Shape follows the Gitleaks default ruleset (MIT), the most complete open,",
    "auditable catalog of this kind, plus vendor prefix documentation:",
    "  id           stable identifier, used in the corpus",
    "  label        what appears in the mask and the notice",
    "  pattern      Python-JavaScript intersection regex; no named groups",
    "  keywords     literal prefilter \u2014 the regex only runs if one is present.",
    "               This is the single biggest performance win when scanning",
    "               every tool result, and it is why the catalog can be long.",
    "  entropy      optional Shannon-entropy floor on the matched secret",
    "  allowlist    regexes that suppress a match (documentation examples)",
    "  secret_group optional capture group to mask instead of the whole match,",
    "               so a URL keeps its host and only the password is replaced",
    "",
    "STAGE 1 by design: prefix-anchored vendor tokens plus structural",
    "indicators. These carry near-zero false positives and need no entropy",
    "tuning. Generic high-entropy and keyword-proximity rules are deliberately",
    "NOT here \u2014 they are the highest-FP class in every scanner, and a redactor",
    "that cries wolf gets turned off.",
    "",
    "A shape match is necessary, not sufficient: several issuers embed",
    "checksums (GitHub and npm CRC32) that would eliminate the remaining false",
    "positives offline. Not implemented yet; noted so it is not forgotten."
  ],
  "version": 2,
  "deny_read_flags": "i",
  "deny_read_paths": [
    {
      "what": ".env file",
      "pattern": "(^|/)\\.env(\\.[^/]*)?$"
    },
    {
      "what": "SSH key material",
      "pattern": "(^|/)\\.ssh/"
    },
    {
      "what": "PEM key/certificate",
      "pattern": "\\.pem$"
    },
    {
      "what": "private key",
      "pattern": "\\.key$"
    },
    {
      "what": "AWS credentials",
      "pattern": "(^|/)\\.aws/"
    },
    {
      "what": "gcloud credentials",
      "pattern": "(^|/)\\.config/gcloud/"
    },
    {
      "what": "Azure credentials",
      "pattern": "(^|/)\\.azure/"
    },
    {
      "what": "GnuPG keyring",
      "pattern": "(^|/)\\.gnupg/"
    },
    {
      "what": ".netrc",
      "pattern": "(^|/)\\.netrc$"
    },
    {
      "what": ".pgpass",
      "pattern": "(^|/)\\.pgpass$"
    },
    {
      "what": "gh auth hosts",
      "pattern": "(^|/)\\.config/gh/hosts\\.yml$"
    },
    {
      "what": "docker registry auth",
      "pattern": "(^|/)\\.docker/config\\.json$"
    },
    {
      "what": "kubeconfig",
      "pattern": "(^|/)\\.kube/config$"
    },
    {
      "what": "terraform state",
      "pattern": "\\.tfstate$"
    }
  ],
  "redaction": {
    "mask": "[redacted:{label}]",
    "rules": [
      {
        "id": "aws-access-key-id",
        "label": "aws access key id",
        "pattern": "\\b(?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16}\\b",
        "keywords": [
          "AKIA",
          "ASIA",
          "ABIA",
          "ACCA",
          "A3T"
        ],
        "note": "Deliberately NOT allowlisting `.+EXAMPLE$` the way Gitleaks does: that allowlist exists to keep repository scans quiet about documentation, and the trade is the other way round when redacting a transcript."
      },
      {
        "id": "gcp-api-key",
        "label": "gcp api key",
        "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b",
        "keywords": [
          "AIza"
        ]
      },
      {
        "id": "gcp-oauth-refresh",
        "label": "gcp oauth refresh token",
        "pattern": "\\b1//[0-9A-Za-z_-]{43,128}\\b",
        "keywords": [
          "1//"
        ]
      },
      {
        "id": "gcp-oauth-access",
        "label": "gcp oauth access token",
        "pattern": "\\bya29\\.[0-9A-Za-z_-]{20,}",
        "keywords": [
          "ya29."
        ]
      },
      {
        "id": "azure-ad-client-secret",
        "label": "azure ad client secret",
        "pattern": "\\b[a-zA-Z0-9_~.]{3}\\dQ~[a-zA-Z0-9_~.-]{31,34}\\b",
        "keywords": [
          "Q~"
        ]
      },
      {
        "id": "digitalocean-token",
        "label": "digitalocean token",
        "pattern": "\\bdo[oprt]_v1_[a-f0-9]{64}\\b",
        "keywords": [
          "dop_v1_",
          "doo_v1_",
          "dor_v1_"
        ]
      },
      {
        "id": "cloudflare-origin-ca",
        "label": "cloudflare origin ca key",
        "pattern": "\\bv1\\.0-[0-9a-f]{24}-[0-9a-f]{146}\\b",
        "keywords": [
          "v1.0-"
        ]
      },
      {
        "id": "vault-token",
        "label": "hashicorp vault token",
        "pattern": "\\bhv[sbr]\\.[A-Za-z0-9_-]{24,}",
        "keywords": [
          "hvs.",
          "hvb.",
          "hvr."
        ]
      },
      {
        "id": "terraform-cloud-token",
        "label": "terraform cloud token",
        "pattern": "\\b[A-Za-z0-9]{14}\\.atlasv1\\.[A-Za-z0-9]{60,70}\\b",
        "keywords": [
          ".atlasv1."
        ]
      },
      {
        "id": "github-token",
        "label": "github token",
        "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,251}|github_pat_[0-9A-Za-z_]{82})\\b",
        "keywords": [
          "ghp_",
          "gho_",
          "ghu_",
          "ghs_",
          "ghr_",
          "github_pat_"
        ]
      },
      {
        "id": "gitlab-token",
        "label": "gitlab token",
        "pattern": "\\b(?:glpat-[0-9A-Za-z_-]{20,}|gloas-[0-9A-Za-z_-]{64}|glptt-[0-9a-f]{40}|glrt-[0-9A-Za-z_-]{20,})\\b",
        "keywords": [
          "glpat-",
          "gloas-",
          "glptt-",
          "glrt-"
        ]
      },
      {
        "id": "npm-token",
        "label": "npm access token",
        "pattern": "\\bnpm_[0-9A-Za-z]{36}\\b",
        "keywords": [
          "npm_"
        ]
      },
      {
        "id": "pypi-token",
        "label": "pypi token",
        "pattern": "\\bpypi-AgEIcHlwaS5vcmc[0-9A-Za-z_-]{50,1000}\\b",
        "keywords": [
          "pypi-"
        ]
      },
      {
        "id": "docker-hub-pat",
        "label": "docker hub token",
        "pattern": "\\bdckr_[po]at_[A-Za-z0-9_-]{20,64}\\b",
        "keywords": [
          "dckr_pat_",
          "dckr_oat_"
        ]
      },
      {
        "id": "artifactory-key",
        "label": "jfrog artifactory api key",
        "pattern": "\\bAKCp[A-Za-z0-9]{69}\\b",
        "keywords": [
          "AKCp"
        ]
      },
      {
        "id": "circleci-pat",
        "label": "circleci token",
        "pattern": "\\bCCIP(?:AT|RJ)_[1-9A-HJ-NP-Za-km-z]{20,30}_[0-9a-f]{40}\\b",
        "keywords": [
          "CCIPAT_",
          "CCIPRJ_"
        ]
      },
      {
        "id": "rubygems-token",
        "label": "rubygems token",
        "pattern": "\\brubygems_[0-9a-f]{48}\\b",
        "keywords": [
          "rubygems_"
        ]
      },
      {
        "id": "langfuse-key",
        "label": "langfuse key",
        "pattern": "\\b[ps]k-lf-[A-Za-z0-9-]{8,}",
        "keywords": [
          "sk-lf-",
          "pk-lf-"
        ]
      },
      {
        "id": "openai-key",
        "label": "openai api key",
        "pattern": "\\bsk-(?:proj-|svcacct-|admin-)?[0-9A-Za-z_-]{20,74}T3BlbkFJ[0-9A-Za-z_-]{20,74}\\b",
        "keywords": [
          "T3BlbkFJ"
        ]
      },
      {
        "id": "anthropic-key",
        "label": "anthropic api key",
        "pattern": "\\bsk-ant-(?:api03|admin01)-[0-9A-Za-z_-]{93}AA\\b",
        "keywords": [
          "sk-ant-"
        ]
      },
      {
        "id": "openrouter-key",
        "label": "openrouter api key",
        "pattern": "\\bsk-or-v1-[A-Za-z0-9_-]{32,128}\\b",
        "keywords": [
          "sk-or-v1-"
        ]
      },
      {
        "id": "huggingface-token",
        "label": "hugging face token",
        "pattern": "\\bhf_[0-9A-Za-z]{34}\\b",
        "keywords": [
          "hf_"
        ]
      },
      {
        "id": "groq-key",
        "label": "groq api key",
        "pattern": "\\bgsk_[A-Za-z0-9]{32,64}\\b",
        "keywords": [
          "gsk_"
        ]
      },
      {
        "id": "perplexity-key",
        "label": "perplexity api key",
        "pattern": "\\bpplx-[A-Za-z0-9]{32,64}\\b",
        "keywords": [
          "pplx-"
        ]
      },
      {
        "id": "generic-sk-key",
        "label": "openai-style sk- key (litellm/deepseek/etc)",
        "pattern": "\\bsk-(?!ant-|or-v1-|proj-|svcacct-|admin-)[A-Za-z0-9_-]{16,}\\b",
        "keywords": [
          "sk-"
        ],
        "note": "No entropy floor on purpose: the `sk-` prefix is itself the signal. A floor here stopped catching low-entropy but real-shaped keys, which the hook's own regression suite caught."
      },
      {
        "id": "stripe-key",
        "label": "stripe key",
        "pattern": "\\b(?:sk|rk)_(?:test|live|prod)_[a-zA-Z0-9]{10,99}\\b",
        "keywords": [
          "sk_test_",
          "sk_live_",
          "sk_prod_",
          "rk_"
        ]
      },
      {
        "id": "stripe-webhook-secret",
        "label": "stripe webhook secret",
        "pattern": "\\bwhsec_[A-Za-z0-9]{32,64}\\b",
        "keywords": [
          "whsec_"
        ]
      },
      {
        "id": "square-token",
        "label": "square token",
        "pattern": "\\bsq0(?:atp|csp)-[0-9A-Za-z_-]{22,43}\\b",
        "keywords": [
          "sq0atp-",
          "sq0csp-"
        ]
      },
      {
        "id": "slack-token",
        "label": "slack token",
        "pattern": "\\bxox[baprse]-[0-9A-Za-z-]{10,48}\\b",
        "keywords": [
          "xox"
        ]
      },
      {
        "id": "slack-webhook",
        "label": "slack webhook url",
        "pattern": "https://hooks\\.slack\\.com/services/T[a-zA-Z0-9_]{8,}/B[a-zA-Z0-9_]{8,12}/[a-zA-Z0-9_]{24}",
        "keywords": [
          "hooks.slack.com"
        ]
      },
      {
        "id": "slack-app-token",
        "label": "slack app-level token",
        "pattern": "\\bxapp-[0-9]-[A-Z0-9]+-[0-9]+-[a-z0-9]+\\b",
        "keywords": [
          "xapp-"
        ]
      },
      {
        "id": "telegram-bot-token",
        "label": "telegram bot token",
        "pattern": "[0-9]{8,10}:AA[0-9A-Za-z_-]{33}",
        "keywords": [
          ":AA"
        ]
      },
      {
        "id": "twilio-api-key",
        "label": "twilio api key",
        "pattern": "\\bSK[0-9a-fA-F]{32}\\b",
        "keywords": [
          "SK"
        ],
        "entropy": 3.0
      },
      {
        "id": "sendgrid-key",
        "label": "sendgrid api key",
        "pattern": "\\bSG\\.[a-zA-Z0-9_-]{22}\\.[a-zA-Z0-9_-]{43}\\b",
        "keywords": [
          "SG."
        ]
      },
      {
        "id": "discord-bot-token",
        "label": "discord bot token",
        "pattern": "\\b[MNO][A-Za-z\\d_-]{23,}\\.[\\w-]{6}\\.[\\w-]{27,}\\b",
        "keywords": [
          "."
        ],
        "entropy": 3.5
      },
      {
        "id": "facebook-token",
        "label": "facebook access token",
        "pattern": "\\bEAA[MC][A-Za-z0-9]{100,}\\b",
        "keywords": [
          "EAAM",
          "EAAC"
        ]
      },
      {
        "id": "shopify-token",
        "label": "shopify token",
        "pattern": "\\bshp(?:at|ca|pa|ss)_[a-zA-Z0-9]{32,64}\\b",
        "keywords": [
          "shpat_",
          "shpca_",
          "shppa_",
          "shpss_"
        ]
      },
      {
        "id": "notion-token",
        "label": "notion token",
        "pattern": "\\b(?:ntn_[A-Za-z0-9]{40,}|secret_[A-Za-z0-9]{43})\\b",
        "keywords": [
          "ntn_",
          "secret_"
        ]
      },
      {
        "id": "linear-key",
        "label": "linear api key",
        "pattern": "\\blin_api_[A-Za-z0-9]{40}\\b",
        "keywords": [
          "lin_api_"
        ]
      },
      {
        "id": "airtable-pat",
        "label": "airtable pat",
        "pattern": "\\bpat[A-Za-z0-9]{14}\\.[a-f0-9]{64}\\b",
        "keywords": [
          "pat"
        ]
      },
      {
        "id": "postman-key",
        "label": "postman api key",
        "pattern": "\\bPMA[KT]-[a-f0-9]{24}-[a-f0-9]{34}\\b",
        "keywords": [
          "PMAK-",
          "PMAT-"
        ]
      },
      {
        "id": "atlassian-token",
        "label": "atlassian api token",
        "pattern": "\\bATATT3[A-Za-z0-9_\\-=]{186}\\b",
        "keywords": [
          "ATATT3"
        ]
      },
      {
        "id": "grafana-token",
        "label": "grafana token",
        "pattern": "\\b(?:glc_[A-Za-z0-9+/]{32,400}={0,3}|glsa_[A-Za-z0-9]{32}_[A-Fa-f0-9]{8})\\b",
        "keywords": [
          "glc_",
          "glsa_"
        ]
      },
      {
        "id": "dynatrace-token",
        "label": "dynatrace token",
        "pattern": "\\bdt0c01\\.[A-Za-z0-9]{24}\\.[A-Za-z0-9]{64}\\b",
        "keywords": [
          "dt0c01."
        ]
      },
      {
        "id": "newrelic-key",
        "label": "new relic key",
        "pattern": "\\bNRAK-[A-Z0-9]{27}\\b",
        "keywords": [
          "NRAK-"
        ]
      },
      {
        "id": "doppler-token",
        "label": "doppler token",
        "pattern": "\\bdp\\.pt\\.[A-Za-z0-9]{43}\\b",
        "keywords": [
          "dp.pt."
        ]
      },
      {
        "id": "planetscale-token",
        "label": "planetscale token",
        "pattern": "\\bpscale_(?:tkn|pw|oauth)_[A-Za-z0-9=._-]{32,64}\\b",
        "keywords": [
          "pscale_"
        ]
      },
      {
        "id": "databricks-token",
        "label": "databricks token",
        "pattern": "\\bdapi[a-f0-9]{32}(?:-\\d)?\\b",
        "keywords": [
          "dapi"
        ]
      },
      {
        "id": "private-key-block",
        "label": "private key block",
        "pattern": "-----BEGIN[ A-Z0-9_-]{0,100}PRIVATE KEY(?: BLOCK)?-----[\\s\\S]*?-----END[ A-Z0-9_-]{0,100}PRIVATE KEY(?: BLOCK)?-----",
        "keywords": [
          "PRIVATE KEY"
        ]
      },
      {
        "id": "jwt",
        "label": "jwt",
        "pattern": "\\bey[A-Za-z0-9_-]{10,}\\.ey[A-Za-z0-9/_-]{10,}\\.[A-Za-z0-9/_-]{10,}",
        "keywords": [
          "ey"
        ]
      },
      {
        "id": "basic-auth-url",
        "label": "credential in a url",
        "pattern": "[a-zA-Z][a-zA-Z0-9+.-]*://[^:@\\s/]+:([^@\\s/]{3,})@",
        "keywords": [
          "://"
        ],
        "secret_group": 1
      },
      {
        "id": "netrc-password",
        "label": "netrc password",
        "pattern": "machine\\s+\\S+\\s+login\\s+\\S+\\s+password\\s+(\\S+)",
        "keywords": [
          "machine"
        ],
        "secret_group": 1,
        "flags": "i"
      }
    ],
    "named_assignment": {
      "note": "Values with NO recognisable shape, caught by the NAME they are bound to. The worst value in the 2026-07-27 leak was a bare hex database password, which every shape rule above misses. Assignment may be `=` (dotenv/shell) or `:` (yaml/json). Groups: 1=name 2=separator 3=value.",
      "pattern": "\\b([A-Za-z0-9_.\\-]*(?:password|passwd|secret|tokens?(?![A-Za-z])|api[_-]?key|access[_-]?key|salt[_-]?key|private[_-]?key|credential|auth[_-]?value)[A-Za-z0-9_.\\-]*)(\\s*[:=]\\s*\"?'?)([^\\s\"',{}]{8,})",
      "flags": "i"
    },
    "benign_value": {
      "note": "References and placeholders, not live material. Redacting these hides real signal \u2014 a MISSING credential would look identical to a set one \u2014 and trains the reader to ignore the marker.",
      "pattern": "^(os\\.environ/.*|\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?|<[^>]*>|change[_-]?me.*|example.*|placeholder.*|dummy.*|fake.*|test.*|none|null|nil|true|false|\"\"|''|sk-example|valuefrom|secretkeyref|.*\\.\\.\\..*)$",
      "flags": "i"
    }
  }
}
